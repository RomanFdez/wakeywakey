<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- App Sandbox: obligatorio en la Mac App Store -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- EventKit: leer el calendario del usuario -->
	<key>com.apple.security.personal-information.calendars</key>
	<true/>
	<!-- Red saliente: RevenueCat / App Store, y OAuth si aplica -->
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- Notificaciones Time Sensitive (también en macOS) -->
	<key>com.apple.developer.usernotifications.time-sensitive</key>
	<true/>
	<!-- App group compartido con el widget -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.sierraespada.wakeywakey</string>
	</array>
</dict>
</plist>
